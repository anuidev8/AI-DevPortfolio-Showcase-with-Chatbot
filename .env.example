# Server-side secrets (never expose to the client)
NOTION_API_KEY=

# Public keys available in the browser (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_ELEVENLABS_API_KEY=

# Public site URL used by the NoShy QR (phones need a real https domain)
NEXT_PUBLIC_SITE_URL=https://anuidev8-porfolio.vercel.app

# ── NoShy Networking (used by /noshy route) ──────────────────────────────────
# PostgreSQL connection string (Railway, Supabase, Neon, etc.)
# The same DATABASE_URL used in Kingdom Creators works here.
DATABASE_URL=

# OpenRouter API key for AI match cards (openrouter.ai → free models available)
OPENAI_API_KEY=
# Optional: override the base URL if using a different OpenAI-compatible provider
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional: override the model (default: nvidia/nemotron-3-nano-30b-a3b:free)
OPENROUTER_MODEL=
