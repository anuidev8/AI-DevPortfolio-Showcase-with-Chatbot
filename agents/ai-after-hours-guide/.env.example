LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ai-after-hours-guide

# Set to off to disable LiveKit Cloud OTLP telemetry during local dev
LIVEKIT_TELEMETRY=off

# Pipeline: Deepgram STT + LiveKit Inference LLM + ElevenLabs TTS
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=es
LLM_MODEL=google/gemma-4-31b-it

# ElevenLabs TTS — https://elevenlabs.io/app/voice-lab
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_TTS_MODEL=eleven_flash_v2_5
TTS_LANGUAGE=es
# float 0.6–1.5, or slow | normal | fast
TTS_SPEED=normal

# Expressive voice — lower stability / higher style = more emotion
TTS_STABILITY=0.28
TTS_SIMILARITY_BOOST=0.82
TTS_STYLE=0.55
TTS_SPEAKER_BOOST=true

# Soft pause between slides during the opening tour (seconds)
TOUR_PAUSE_S=1.1

# Seconds to wait for the browser before first RPC
PARTICIPANT_WAIT_SECONDS=12
