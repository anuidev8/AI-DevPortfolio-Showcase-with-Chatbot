LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=noshy-voice-host

# Set to off to disable LiveKit Cloud OTLP telemetry during local dev
LIVEKIT_TELEMETRY=off

# Language the host starts in: es (default, Colombian Spanish) or en.
# The host is multilingual and switches when the guest speaks another language.
AGENT_LANGUAGE=es

# Pipeline: Deepgram STT + LiveKit Inference LLM + ElevenLabs TTS
STT_MODEL=deepgram/nova-3
# multi = multilingual (es, en, pt, fr, ...); set es to lock recognition to Spanish
STT_LANGUAGE=multi
LLM_MODEL=google/gemma-4-31b-it

# ElevenLabs TTS — https://elevenlabs.io/app/voice-lab
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
# eleven_multilingual_v2 sounds most human; eleven_flash_v2_5 answers faster
ELEVEN_TTS_MODEL=eleven_multilingual_v2
# Leave empty so the voice follows the conversation language
TTS_LANGUAGE=
# float 0.6–1.5, or slow | normal | fast
TTS_SPEED=0.9
# Slower speed for the soft opener ("Hey, mor… ¿cómo vas?"), 0.7–1.2
INTRO_SPEED=0.78

TTS_STABILITY=0.45
TTS_SIMILARITY_BOOST=0.8
TTS_STYLE=0.3
TTS_SPEAKER_BOOST=true

# Seconds to wait for the browser before the first RPC
PARTICIPANT_WAIT_SECONDS=12

# Mic filter for loud events (ai-coustics, runs on LiveKit Cloud):
#   voice = isolate the guest's voice from people talking nearby (extra per-minute cost)
#   noise = remove non-speech noise only (music, fans; included)
#   off   = no filter
NOISE_FILTER=voice
# 0.0–1.0, how aggressive the filter is
NOISE_FILTER_LEVEL=0.85
